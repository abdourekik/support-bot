# Copy this file to .env and fill in real values. Never commit .env.

# Google Gemini API (free tier) - https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase (hosted, free plan) - Project Settings > API / Database
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# n8n - generate once, e.g. `openssl rand -hex 32`, and never change it afterwards
N8N_ENCRYPTION_KEY=

# React widget (Vite exposes only VITE_* variables to the browser)
VITE_CHAT_WEBHOOK_URL=http://localhost:5678/webhook/chat
VITE_ESCALATION_WEBHOOK_URL=http://localhost:5678/webhook/escalation-email
